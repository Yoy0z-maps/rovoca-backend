# Django
DEBUG=True
SECRET_KEY=replace-me
ALLOWED_HOSTS=localhost,127.0.0.1,.run.app,api.rovoca.site
CSRF_TRUSTED_ORIGINS=https://*.run.app,https://api.rovoca.site
SECURE_SSL_REDIRECT=False
KAKAO_AUD=replace-me
GOOGLE_AUD=replace-me.apps.googleusercontent.com

# PostgreSQL. Use DB_ENGINE=sqlite for local smoke tests only.
DB_ENGINE=postgresql
DB_NAME=rovoca
DB_USER=rovoca
DB_PASSWORD=replace-me
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Media storage: local, s3, or gcs
STORAGE_BACKEND=local
GS_PROJECT_ID=replace-me
GS_BUCKET_NAME=replace-me-media
GS_QUERYSTRING_AUTH=True
GS_IAM_SIGN_BLOB=True
GS_SA_EMAIL=replace-me@replace-me.iam.gserviceaccount.com

# Generate a fresh key pair for a new environment.
JWT_PRIVATE_KEY_FILE=private.pem
JWT_PUBLIC_KEY_FILE=public.pem
